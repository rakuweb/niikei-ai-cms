{
  "name": "nextjs-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next-sitemap && next export",
    "export:optimized": "next build && next-sitemap && next export && next-export-optimize-images",
    "test": "jest",
    "format": "prettier --write ./src",
    "generate": "hygen component new",
    "postbuild": "next-sitemap",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storycap": "storycap --verbose --server-cmd \"yarn storybook\" http://localhost:6006 --server-timeout 100000",
    "reg-cli": "npx reg-cli actual expected diff -R index.html",
    "gen:theme-typings": "chakra-cli tokens ./src/lib/theme/index.ts"
  },
