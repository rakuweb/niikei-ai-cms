{
  "name": "nextjs-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next-sitemap && next export",
    "export:optimized": "next build && next-sitemap && next export && next-export-optimize-images",
    "test": "jest",
    "format": "prettier --write ./src",
    "generate": "hygen component new",
    "postbuild": "next-sitemap",
    "storybook": "start-storybook -p 6006",
    "build-storybook": "build-storybook",
    "gen:theme-typings": "chakra-cli tokens ./src/lib/theme/index.ts"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.5.5",
    "@emotion/react": "^11.10.6",
    "@emotion/styled": "^11.10.6",
    "@vanilla-extract/css": "^1.11.0",
    "firebase-functions": "^3.23.0",
    "framer-motion": "^10.10.0",
    "next": "13.2.4",
    "next-seo": "^6.0.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "zustand": "^4.3.7",
    "firebase-frameworks": "^0.7.0",
    "firebase-admin": "^11.0.1"
  },
  "lint-staged": {
    "*.@(ts|tsx})": [
      "yarn lint .",
      "yarn format"
    ]
  },
  "volta": {
    "node": "18.15.0"
  },
  "main": "server.js",
  "engines": {
    "node": "18"
  }
}